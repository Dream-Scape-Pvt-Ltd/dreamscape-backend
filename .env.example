DEBUG=True
SECRET_KEY=change-me-in-production
DB_NAME=dreamscape_db
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Phase 6: run a Redis broker, Celery worker and Celery Beat.
CELERY_BROKER_URL=redis://localhost:6379/0
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=no-reply@dreamscapetreks.com
B2B_ADMIN_EMAIL=
# Optional absolute path; defaults to backend/private_media (never expose publicly).
# B2B_PRIVATE_ROOT=D:/private/dreamscape
B2B_DOWNLOAD_TTL=300
PUBLIC_SITE_URL=https://dreamscape-treks.com

# Backblaze B2 media storage (private bucket, signed URLs)
USE_B2=False
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=dreamscape-trek-images
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_URL_EXPIRE=3600
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:8000
